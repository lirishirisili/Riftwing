; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Riftstrike"
config/description="RIFTSTRIKE - portrait mobile arcade shooter (prototype)."
config/version="0.1.7"
run/main_scene="res://scenes/app/app_root.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.011765, 0.027451, 0.070588, 1)
config/icon="res://assets/branding/icon_main_192.png"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Palette="*res://scripts/core/palette.gd"
PlatformServices="*res://scripts/services/platform_services.gd"
AudioManager="*res://scripts/services/audio_manager.gd"
GameFeel="*res://scripts/core/game_feel.gd"
SaveManager="*res://scripts/services/save_manager.gd"
SceneRouter="*res://scripts/core/scene_router.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://resources/theme/riftwing_theme.tres"

[input]

drag_primary={
