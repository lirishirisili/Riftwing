[config]
name="RiftstrikeLevelPlay"
binary="riftstrike_levelplay.xcframework"

initialization="register_riftstrike_levelplay_types"
deinitialization="unregister_riftstrike_levelplay_types"

[dependencies]
; The LevelPlay iOS SDK (IronSourceSDK 9.5.0.0) is added to the generated Xcode
; project via CocoaPods or SPM (see native/levelplay/ios/README.md). System
; frameworks required by LevelPlay:
linked=[]
embedded=[]
system=[
  "AdSupport.framework",
  "AppTrackingTransparency.framework",
  "StoreKit.framework",
  "WebKit.framework",
  "JavaScriptCore.framework",
  "SystemConfiguration.framework"
]
capabilities=[]
files=[]
linker_flags=["-ObjC"]

